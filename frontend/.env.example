# Generadas por `npm run stellar:setup`.
# Pagos en USDC Circle testnet (issuer fijo en código). FUNDER solo aporta XLM (reserva/fees).
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
FUNDER_SECRET=
ORGANIZER_DEMO_SECRET=

# 32 bytes en base64. Cifra las claves de las cuentas custodiales: si cambia, las cuentas existentes quedan inaccesibles.
ORILLA_ENCRYPTION_KEY=

# Supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Producción
ORILLA_PROD_MODE=false
